{
  "entities": {
    "reviewee": {
      "title": "Reviewee",
      "description": "Represents an enrolled reviewee candidate",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "System generated document ID"
        },
        "last_name": {
          "type": "string",
          "description": "Uppercase last name"
        },
        "first_name": {
          "type": "string",
          "description": "Uppercase first name"
        },
        "middle_name": {
          "type": "string",
          "description": "Uppercase middle name"
        },
        "school_name": {
          "type": "string",
          "description": "Uppercase high school name"
        },
        "pin": {
          "type": "string",
          "description": "Humble PIN security number"
        },
        "seq_id": {
          "type": "string",
          "description": "Continuous sequential enrollment code (e.g. SRC - 000026)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Standard timestamp"
        },
        "role": {
          "type": "string",
          "description": "The security and functional role assigned to this user"
        }
      },
      "required": ["last_name", "first_name", "school_name", "pin", "seq_id", "created_at"]
    },
    "counter": {
      "title": "Counter",
      "description": "Central atomic sequential counter state document",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Current cumulative sequence ID order count"
        },
        "year": {
          "type": "integer",
          "description": "The relevant tracker year"
        }
      },
      "required": ["count", "year"]
    },
    "fcmToken": {
      "title": "FCM Token",
      "description": "Stores a registration token for push notifications",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "The FCM registration token"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["token", "createdAt"]
    },
    "scoreFolder": {
      "title": "Score Folder",
      "description": "Represents an examination batch or coaching period folder created by admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique folder identifier"
        },
        "name": {
          "type": "string",
          "description": "Display name of the score folder"
        },
        "folderType": {
          "type": "string",
          "description": "Type of folder: phase_1, phase_2, marathon, final_coaching, or custom"
        },
        "publicationStatus": {
          "type": "string",
          "description": "Publication state: published, hidden, or draft"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether the folder is archived"
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Whether the folder is soft deleted"
        },
        "schoolScope": {
          "type": "string",
          "description": "School accessibility scope: all or selected"
        },
        "branchScope": {
          "type": "string",
          "description": "Branch accessibility scope: all or selected"
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID or email who created the folder"
        }
      },
      "required": ["name", "folderType"]
    }
  },
  "firestore": {
    "users": {
      "schema": {
        "$ref": "#/entities/reviewee"
      },
      "description": "Highly persistent global collection of verified enrolled users/reviewees"
    },
    "/users/{userId}/fcmTokens/{tokenId}": {
      "schema": {
        "$ref": "#/entities/fcmToken"
      },
      "description": "FCM tokens for push notifications, scoped by user"
    },
    "counters": {
      "schema": {
        "$ref": "#/entities/counter"
      },
      "description": "Single-document transactional counter to generate exact gapless sequence IDs"
    },
    "config": {
      "schema": {
        "$ref": "#/entities/config"
      },
      "description": "Global application configuration"
    },
    "scoreFolders": {
      "schema": {
        "$ref": "#/entities/scoreFolder"
      },
      "description": "Score folders collection (camelCase) created by admin"
    },
    "score_folders": {
      "schema": {
        "$ref": "#/entities/scoreFolder"
      },
      "description": "Score folders collection (snake_case) created by admin"
    }
  }
}
