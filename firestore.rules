rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return getUserDoc().data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == "Admin";
    }

    function isStaff() {
      return signedIn() && userRole() == "Staff";
    }

    function isAdminLike() {
      return isAdmin() || isStaff();
    }

    function isReviewee() {
      return signedIn() && userRole() == "Reviewee";
    }

    function isSchoolInScope(folderData, userData) {
      return !('schoolScope' in folderData) || folderData.schoolScope != 'selected' || (
        ('selectedSchoolIds' in folderData && (
          ('schoolId' in userData && folderData.selectedSchoolIds.hasAny([userData.schoolId])) ||
          ('school_id' in userData && folderData.selectedSchoolIds.hasAny([userData.school_id]))
        )) ||
        ('selectedSchoolNames' in folderData && (
          ('schoolName' in userData && folderData.selectedSchoolNames.hasAny([userData.schoolName])) ||
          ('school_name' in userData && folderData.selectedSchoolNames.hasAny([userData.school_name])) ||
          ('school' in userData && folderData.selectedSchoolNames.hasAny([userData.school]))
        ))
      );
    }

    function isBranchInScope(folderData, userData) {
      return !('branchScope' in folderData) || folderData.branchScope != 'selected' || (
        ('selectedBranchIds' in folderData && (
          ('branchId' in userData && folderData.selectedBranchIds.hasAny([userData.branchId])) ||
          ('branch_id' in userData && folderData.selectedBranchIds.hasAny([userData.branch_id]))
        )) ||
        ('selectedBranchNames' in folderData && (
          ('branchName' in userData && folderData.selectedBranchNames.hasAny([userData.branchName])) ||
          ('branch_name' in userData && folderData.selectedBranchNames.hasAny([userData.branch_name])) ||
          ('reviewBranch' in userData && folderData.selectedBranchNames.hasAny([userData.reviewBranch])) ||
          ('review_branch' in userData && folderData.selectedBranchNames.hasAny([userData.review_branch])) ||
          ('branch' in userData && folderData.selectedBranchNames.hasAny([userData.branch]))
        ))
      );
    }

    function isUserInFolderScope(folderData) {
      return isSchoolInScope(folderData, getUserDoc().data) &&
             isBranchInScope(folderData, getUserDoc().data);
    }

    match /audit_logs/{id} {
      allow create: if isAdminLike();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if signedIn() && (resource.data.recipientId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']));
    }

    match /user_preferences/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isAdminLike() || (request.auth != null && request.auth.uid == userId);
      allow delete: if isAdmin();

      match /fcmTokens/{tokenId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }
    }
    
    // Counters - Public for registration logic
    match /counters/{id} {
      allow read, write: if true;
    }

    // Config - Public for school mappings
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /score_folders/{folderId} {
      allow read: if isAdminLike() || (
        isReviewee() &&
        resource.data.publicationStatus == 'published' &&
        resource.data.isArchived != true &&
        isUserInFolderScope(resource.data)
      );
      allow create, update, delete: if isAdminLike();
    }

    match /scoreFolders/{folderId} {
      allow read: if isAdminLike() || (
        isReviewee() &&
        resource.data.publicationStatus == 'published' &&
        resource.data.isArchived != true &&
        isUserInFolderScope(resource.data)
      );
      allow create, update, delete: if isAdminLike();
    }

    // Default
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
